---
import Layout from '../layouts/Layout.astro';

import { autorizacion } from '../lib/autorizacion';
import { query } from '../lib/db';
import ModalCambioFoto from '../components/modal-cambiofoto';

export const prerender = false;


const authRedirect = await autorizacion(Astro, { nuevapagina: '/404' });
if (authRedirect) return authRedirect;

const sid = Astro.cookies.get('sid')?.value;
const datosUsuario = await query('SELECT nombre, fecha_alta FROM usuario WHERE id_usuario = (SELECT id_usuario FROM sesion WHERE id_sesion = $1)', [sid]);
const rolesUsuario = await query('SELECT id_rol FROM usuariorol WHERE id_usuario = (SELECT id_usuario FROM sesion WHERE id_sesion = $1)', [sid]);

// Comprueba si el usuario tiene el rol 2
const tieneRol2 = rolesUsuario.rows.some(rol => rol.id_rol === 2);

/*
